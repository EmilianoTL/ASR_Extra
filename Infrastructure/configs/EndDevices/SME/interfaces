# =====================================================================
#  /etc/network/interfaces  —  SME (Alpine Linux)
# ---------------------------------------------------------------------
#  eth0 -> Red de TOPOLOGÍA / gestión (LAN de R1, vía Switch1).
#          IP estática, SIN gateway por defecto.
#  eth1 -> Internet vía NAT (DHCP). Provee la ruta por defecto y sirve
#          para 'apk update', github y todo lo de la máquina.
#
#  Regla: lo de la topología sale por eth0; todo lo demás por eth1.
#  Las rutas de topología (vía R1) las aplica /usr/local/sbin/sme-routes.sh.
#  DNS = 1.1.1.1 (en /etc/resolv.conf), sale por eth1 sin excepciones.
# =====================================================================

auto lo
iface lo inet loopback

# --- eth0: LAN de gestión de R1, 148.204.56.0/24 (SME = .10) ---
auto eth0
iface eth0 inet static
    address 148.204.56.10
    netmask 255.255.255.0
    # Aplica rutas de topología al levantar eth0 (todo vía R1 = .1)
    post-up   /usr/local/sbin/sme-routes.sh up   || true
    pre-down  /usr/local/sbin/sme-routes.sh down || true

# --- eth1: Internet por DHCP (NAT) ---
auto eth1
iface eth1 inet dhcp
