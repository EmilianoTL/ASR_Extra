# ── Servidor Flask ───────────────────────────────────────────────────────────
FLASK_APP=app.py
FLASK_DEBUG=True
FLASK_PUERTO=5000

# ── Base de datos ────────────────────────────────────────────────────────────
DB_NAME=red_asr.db

# ── Credenciales SSH / Ansible (comunes a todos los routers) ────────────────
ROUTER_USER=admin
ROUTER_PASS=cisco123
ROUTER_ENABLE=enable123

# ── SNMPv3 (SHA auth + DES56 priv) ──────────────────────────────────────────
SNMP_USER=snmp_user
SNMP_AUTH_PASS=authpass123
SNMP_PRIV_PASS=privpass123
SNMP_PORT=161
TRAP_PORT=162

# ── Descubrimiento de topología ──────────────────────────────────────────────
# Router semilla para el BFS por CDP (R1, alcanzable directo desde la SME).
SEED_ROUTER_IP=148.204.56.1

# ── Monitor de pérdida de paquetes R1 -> R2 ──────────────────────────────────
PACKET_LOSS_THRESHOLD=25
PACKET_LOSS_INTERVAL=30
PACKET_LOSS_COUNT=10
